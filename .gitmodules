# Vim plugins tracked as gitlinks under src/vim/vim/pack/minpac.
# URLs match the minpac#add() entries in src/vim/vimrc.
# rainbow_levels.vim is vendored as normal files and is not a submodule.

[submodule "src/vim/vim/pack/minpac/opt/minpac"]
	path = src/vim/vim/pack/minpac/opt/minpac
	url = https://github.com/k-takata/minpac.git
[submodule "src/vim/vim/pack/minpac/opt/vim-polyglot"]
	path = src/vim/vim/pack/minpac/opt/vim-polyglot
	url = https://github.com/sheerun/vim-polyglot.git
