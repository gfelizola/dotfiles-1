#!/bin/bash

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Set up Homebrew.

set_homebrew() {
    HARDWARE="$(uname -m)"
    prefix=""

    if [ "$HARDWARE" == "arm64" ]; then
        prefix="/opt/homebrew"
    elif [ "$HARDWARE" == "x86_64" ]; then
        prefix="/usr/local"
    fi

    eval "$($prefix/bin/brew shellenv)"
}

set_homebrew
unset -f set_homebrew

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Configure Homebrew to not auto-update before running commands
# such as: `brew install`, `brew upgrade`, and `brew tap`.
#
# https://docs.brew.sh/Manpage#environment

export HOMEBREW_NO_AUTO_UPDATE=1

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# php@8.3 is keg-only, so Homebrew does not link it into PATH.
# `brew shellenv` above sets HOMEBREW_PREFIX (/opt/homebrew on Apple
# silicon, /usr/local on Intel). Skip the prepend when the formula
# is not installed.

if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -d "${HOMEBREW_PREFIX}/opt/php@8.3/bin" ]; then
    if [ -d "${HOMEBREW_PREFIX}/opt/php@8.3/sbin" ]; then
        PATH="${HOMEBREW_PREFIX}/opt/php@8.3/sbin:${PATH}"
    fi

    # bin stays in front of sbin.
    PATH="${HOMEBREW_PREFIX}/opt/php@8.3/bin:${PATH}"
    export PATH
fi
