#!/bin/bash

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias cd..="cd .."
alias la="ls -la"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Short Git

alias gs="git status"
alias gp="git pull"
alias gpo="git push origin"
alias gps="git push"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gca="git ca"
alias gcm="git ca -m"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

alias cp="cp -iv"
#             │└─ list copied files
#             └─ prompt before overwriting an existing file

alias mkdir="mkdir -pv"
#                   │└─ list created directories
#                   └─ create intermediate directories

alias mv="mv -iv"
#             │└─ list moved files
#             └─ prompt before overwriting an existing file

alias rm="rm -rf --"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

alias :q="exit"
alias c="clear"
alias ch="history -c && > ~/.bash_history"
alias d="cd ~/Desktop"
alias e="vim --"
alias g="git"
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias ll="ls -lA"
alias n="npm"
alias p="cd ~/projects"
alias path='printf "%b\n" "${PATH//:/\\n}"'
alias q="exit"
alias t="tmux"

# Yarn is not installed. Volta's Yarn shim is broken; use bun or pnpm.
# alias y="yarn"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Development

alias dev="npm run dev"
alias bd="bun dev"
alias br="bun run"
alias dev="bun run deploy"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Projects disk. Set PROJECTS_DIR in ~/.bash.local to override.
alias pp='cd "${PROJECTS_DIR:-/Volumes/ADATA-GFELIZOLA/projects}"'

# Open the current directory in Cursor.
alias cs='cursor .'

# Prisma helpers. Confirm these match the owner's shell.
alias pmd='bunx prisma migrate dev'
alias pg='bunx prisma generate'
alias pmdg='bunx prisma migrate dev && bunx prisma generate'

# `gt` is used on the owner's machine, but the audit did not record
# its body. It is intentionally undefined so it cannot shadow Graphite
# or another `gt` binary.
# alias gt=""

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Load OS specific configs.

. "$OS/bash_aliases"
